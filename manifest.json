{
  "manifest_version": 3,
  "name": "Instagram Reels & Video Controller",
  "version": "1.0.0",
  "description": "Media controls, seek bar, playback speed, quality selector, and video downloader for Instagram Reels and videos.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Instagram Reels & Video Controller"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/page-script.js"
      ],
      "matches": [
        "*://*.instagram.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
